# Project Free Kick — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to the repository

# ── Twilio (messaging) ───────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Channel: "whatsapp" (default) or "sms" (for A2P migration)
MESSAGE_CHANNEL=whatsapp

# Required for SMS channel — Twilio Messaging Service SID (A2P 10DLC)
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── User phone numbers (WhatsApp format) ─────────────────
# Comma-separated for multiple users
# e.g. whatsapp:+12039394042,whatsapp:+12035551234
USER_PHONE_NUMBERS=whatsapp:+1xxxxxxxxxx

# ── Football Data API ─────────────────────────────────────
FOOTBALL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App Settings ──────────────────────────────────────────
# Days to send scheduled nudges (0=Mon,2=Wed,4=Fri)
NUDGE_DAYS=0,2,4

# Saving amount ranges per trigger (USD)
# Format: min,max
SAVE_RANGE_SCHEDULED=5,25
SAVE_RANGE_WIN_CORRECT=20,40
SAVE_RANGE_WIN_WRONG=8,12
SAVE_RANGE_DRAW_CORRECT=15,25
SAVE_RANGE_DRAW_WRONG=8,12
SAVE_RANGE_LOSS_CORRECT=25,40
SAVE_RANGE_LOSS_WRONG=8,12
